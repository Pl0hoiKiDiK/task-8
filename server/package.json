{
  "name": "backend",
  "version": "1.0.0",
  "description": "CV Builder Backend",
  "author": "Leanid Tarasiuk",
  "license": "ISC",
  "engines": {
    "node": ">=22.x"
  },
  "scripts": {
    "schema": "ts-node create-definitions",
    "start": "pnpm run schema && nest start --watch",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "image:up": "docker compose -f docker/docker-compose.yml up -d --build",
    "image:down": "docker compose -f docker/docker-compose.yml down",
    "backup": "pnpm run backup:copy && pnpm run backup:restore",
    "backup:copy": "docker cp backups/backup.sql cv_postgres:/tmp/backup.sql",
    "backup:restore": "docker exec -i cv_postgres pg_restore -U user -d db --clean --if-exists --no-owner /tmp/backup.sql"
  },
  "dependencies": {
    "@apollo/server": "^5.4.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/apollo": "^13.2.4",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/graphql": "^13.2.4",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.9.0",
    "dotenv": "^16.4.7",
    "graphql": "^16.5.0",
    "graphql-query-complexity": "^1.1.0",
    "handlebars": "^4.7.7",
    "nodemailer": "^8.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "pg": "^8.7.3",
    "puppeteer": "^24.39.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.5.6",
    "typeorm": "^0.3.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.16",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/node": "^22.12.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.1",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  }
}
